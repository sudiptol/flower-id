# Template for the .env file. Copy it to .env and put the real values there.
# This example file is saved in git; the real .env never is.
PLANTNET_API_KEY=paste-your-key-here

# The passcode that unlocks the app (SPEC.md story 9). Long and hard to guess,
# e.g. four random words. Never reuse a password from another account.
APP_PASSCODE=choose-your-passcode

# A long random value the server uses to sign the "remembered" cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-long-random-value-here
